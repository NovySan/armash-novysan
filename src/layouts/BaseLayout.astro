---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Enchantment Lab — Dan Novy', ogImage = '/images/armash/hero.jpg' } = Astro.props;

const fullTitle = title.includes('|') ? title : `${title} | Enchantment Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body>
    <header class="topbar">
      <a href="/" class="topbar__brand">Enchantment Lab</a>
      <span class="topbar__status">Mission Archive Online</span>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Enchantment Lab · A creative research studio by <a href="https://www.novysan.com" target="_blank" rel="noopener">Dan Novy</a>
      </p>
      <p style="margin-top: 0.5rem; opacity: 0.7;">
        This mission archive is a work of speculative design. <br />
        Operational events are documented; the framing is invented.
      </p>
    </footer>
  </body>
</html>
